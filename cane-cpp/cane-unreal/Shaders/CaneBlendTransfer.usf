#if !CANE_STANDALONE_SHADER
#include "/Engine/Public/Platform.ush"
#endif

Texture2D InputColor;
int Transfer; // -1 Gamma PMA -> linear PMA; +1 inverse
uint OpaqueBackground;

void VertexMain(uint Id : SV_VertexID, out float4 Position : SV_Position)
{
    float2 P = float2((Id << 1u) & 2u, Id & 2u);
    Position = float4(P * 2.0 - 1.0, 0.0, 1.0);
}
float Decode(float V) { return V <= 0.04045 ? V / 12.92 : pow(max(0.0, (V + 0.055) / 1.055), 2.4); }
float Encode(float V) { return V <= 0.0031308 ? V * 12.92 : 1.055 * pow(max(V, 0.0), 1.0 / 2.4) - 0.055; }
float4 PixelMain(float4 Position : SV_Position) : SV_Target0
{
    float4 C = InputColor.Load(int3(int2(Position.xy), 0));
    // Additive layers may accumulate alpha above one. Alpha still follows its
    // blend equation; opaque radiance must never be divided by that accumulation.
    float Coverage = OpaqueBackground != 0 ? 1.0 : saturate(C.a);
    float3 Straight = Coverage > 0.000001 ? C.rgb / Coverage : 0;
    Straight = Transfer < 0 ? float3(Decode(Straight.r), Decode(Straight.g), Decode(Straight.b)) :
        float3(Encode(Straight.r), Encode(Straight.g), Encode(Straight.b));
    return float4(Straight * Coverage, C.a);
}
