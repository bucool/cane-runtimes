#include "/Engine/Public/Platform.ush"

Texture2D InputColor;
StructuredBuffer<float4> ClipPlanes;
uint ClipPlaneCount;
int Transfer; // -1 target -> selected blend space; +1 inverse
float GammaRatio;
uint DecodeHardwareSRGB;
uint TargetEncoded;
uint BlendGamma;

void VertexMain(uint Id : SV_VertexID, out float4 Position : SV_Position)
{
    float2 P = float2((Id << 1u) & 2u, Id & 2u);
    Position = float4(P * 2.0 - 1.0, 0.0, 1.0);
}
float Decode(float V)
{
    return V <= 0.04045 ? V / 12.92 : pow(max(0.0, (V + 0.055) / 1.055), 2.4);
}
float Encode(float V)
{
    return V <= 0.0031308 ? V * 12.92 : 1.055 * pow(max(V, 0.0), 1.0 / 2.4) - 0.055;
}
float4 PixelMain(float4 Position : SV_Position) : SV_Target0
{
    for (uint Plane = 0; Plane < ClipPlaneCount; ++Plane)
        if (dot(float3(Position.xy, 1.0), ClipPlanes[Plane].xyz) < 0.0) discard;
    float4 C = InputColor.Load(int3(int2(Position.xy), 0));
    if (DecodeHardwareSRGB != 0)
        C.rgb = float3(Decode(C.r), Decode(C.g), Decode(C.b));
    if (Transfer != 0)
    {
        float Coverage = saturate(C.a);
        float3 Straight = Coverage > 0.000001 ? C.rgb / Coverage : 0;
        if (Transfer < 0)
        {
            if (TargetEncoded != 0)
                Straight = pow(max(float3(Decode(Straight.r), Decode(Straight.g), Decode(Straight.b)), 0.0), 1.0 / GammaRatio);
            if (BlendGamma != 0) Straight = float3(Encode(Straight.r), Encode(Straight.g), Encode(Straight.b));
        }
        else
        {
            if (BlendGamma != 0) Straight = float3(Decode(Straight.r), Decode(Straight.g), Decode(Straight.b));
            if (TargetEncoded != 0)
            {
                Straight = pow(max(Straight, 0.0), GammaRatio);
                Straight = float3(Encode(Straight.r), Encode(Straight.g), Encode(Straight.b));
            }
        }
        C.rgb = Straight * Coverage;
    }
    return C;
}
